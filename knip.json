{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["eslint.shared.mjs"]
    },
    "packages/app": {},
    "packages/core": {},
    "packages/db": {
      "entry": ["mikro-orm.config.ts", "src/seeders/*.ts", "src/migrations/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts"]
    }
  }
}
