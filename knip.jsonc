{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // The prototype is bundled from index.html → main.tsx by scripts/build-prototype.mjs.
      "entry": ["prototypes/devmentor-journey/main.tsx", "scripts/**/*.mjs"],
      // The integration harness reaches the driver through @devmentor/db's install; declaring it
      // here would let npm resolve a second MikroORM copy (AGENTS.md: only db owns @mikro-orm/*).
      "ignoreDependencies": ["@mikro-orm/postgresql"],
    },
    "packages/app": {},
    "packages/core": {},
    "packages/db": {
      // Loaded implicitly by the MikroORM CLI to run TypeScript config/migrations.
      "ignoreDependencies": ["tsx"],
      "entry": ["src/mikro-orm.config.ts", "src/seeders/*.ts", "migrations/*.ts"],
    },
    "packages/ui": {
      // Generated by `msw init`; served as a static asset by Storybook.
      "ignore": [".storybook/public/mockServiceWorker.js"],
    },
  },
}
