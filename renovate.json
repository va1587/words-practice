{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "description": "Supply-chain policy: only versions published ≥ 14 days ago (mirrors .npmrc min-release-age).",
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "packageRules": [
    {
      "description": "Project requirement: the framework stays on the newest release.",
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "minimumReleaseAge": null,
      "groupName": "Next.js"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    { "matchPackageNames": ["@mikro-orm/**"], "groupName": "MikroORM" },
    {
      "matchPackageNames": [
        "shadcn",
        "@base-ui/react",
        "lucide-react",
        "tailwindcss",
        "@tailwindcss/**",
        "tw-animate-css"
      ],
      "groupName": "UI"
    },
    {
      "matchPackageNames": [
        "eslint",
        "typescript-eslint",
        "prettier",
        "prettier-plugin-tailwindcss",
        "knip",
        "lefthook",
        "@commitlint/**"
      ],
      "groupName": "Lint & tooling"
    },
    {
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "@playwright/test",
        "@axe-core/playwright",
        "@testcontainers/**"
      ],
      "groupName": "Testing"
    },
    { "matchManagers": ["github-actions"], "groupName": "GitHub Actions" },
    {
      "description": "eslint-config-next pins plugins that only support ESLint 9 (see .ai/lessons/eslint-10-blocked-by-next-config.md).",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    }
  ]
}
