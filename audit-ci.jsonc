{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Engineering standards §5.4: fail on high/critical advisories in production dependencies.
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // braces — ReDoS-style stack exhaustion on deeply nested glob patterns. No patched version exists.
    // Reached only via awilix → fast-glob, used by awilix `loadModules`, which DevMentor does not call;
    // no untrusted input reaches a glob. Re-check when a fixed braces/micromatch release appears.
    "GHSA-vfj7-8cjw-p6xm",
  ],
}
