# Supply-chain policy (.ai/specs/2026-10-15-tech-stack-and-engineering-standards.md §2):
# only install versions published at least 14 days ago.
min-release-age=14
# Exception: the framework must stay on the newest release (project requirement).
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
